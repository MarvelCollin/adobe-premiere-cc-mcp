{
  "name": "adobe-premiere-cc-mcp",
  "version": "0.1.0",
  "description": "MCP server for driving Adobe Premiere Pro, with tools that verify their own writes",
  "type": "module",
  "author": "MarvelCollin",
  "homepage": "https://github.com/MarvelCollin/adobe-premiere-cc-mcp#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarvelCollin/adobe-premiere-cc-mcp.git"
  },
  "bugs": {
    "url": "https://github.com/MarvelCollin/adobe-premiere-cc-mcp/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "adobe-premiere-cc-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "panel",
    "artifacts/PremiereMcpLink.zxp",
    "scripts/install-panel.mjs",
    "docs"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/index.js",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "smoke": "node scripts/smoke.mjs",
    "verify": "node scripts/verify.mjs",
    "docs": "node scripts/docs.mjs",
    "prepublishOnly": "npm run check && npm run build",
    "install-panel": "node scripts/install-panel.mjs",
    "sign-panel": "node scripts/sign-panel.mjs"
  },
  "keywords": [
    "mcp",
    "premiere",
    "adobe",
    "video-editing"
  ],
  "license": "MIT",
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "typescript": "^5.7.0",
    "vitest": "^2.1.0"
  }
}
